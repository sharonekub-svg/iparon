# העתק לקובץ בשם .env והכנס את המפתחות שלך:
#   cp .env.example .env && chmod 600 .env
#
# .env נמצא ב-.gitignore. הוא לא נכנס לגיט ולא מגיע לדפדפן.

# ── המוח + חיפוש אינטרנט אמיתי ────────────────────────────────────────
# מ-console.anthropic.com. נותן גם את השיחה וגם את החיפוש ברשת.
# בלי המפתח הזה ג'ארוויס רץ במצב ניתוב-מילים ואומר את זה בקול.
ANTHROPIC_API_KEY=

# ── קול פנימה והחוצה ──────────────────────────────────────────────────
# מ-elevenlabs.io. המסלול החינמי מספיק להתחלה.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# ── נתונים ────────────────────────────────────────────────────────────
# 1 = דמו מומצא, בטוח להקלטת מסך. 0 = התיקיות האמיתיות שלך.
JARVIS_DEMO=1
# JARVIS_VAULT=/home/sharon/notes:/home/sharon/school

# ── כסף ───────────────────────────────────────────────────────────────
# תקרת הוצאה בדולרים. מעליה ג'ארוויס עוצר לגמרי.
JARVIS_SPEND_CAP_USD=2.00

# ── כוונון ────────────────────────────────────────────────────────────
# anthropic = חיפוש טוב, ~0.01$ לחיפוש. free = DuckDuckGo, חינם.
# auto = anthropic אם יש מפתח, אחרת free.
JARVIS_SEARCH=auto
# JARVIS_MODEL=claude-opus-5
# JARVIS_EFFORT=medium
# JARVIS_PORT=8765
