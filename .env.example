# העתק ל־.env מקומי. כל מה שמתחיל ב־EXPO_PUBLIC_ נארז לתוך החבילה
# ונגיש לכל מי שמחזיק את האפליקציה — לכן רק ערכים ציבוריים כאן.
#
# את שני הערכים האלה לוקחים מ-Project Settings → API בקונסולה של Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# חומרי הדגמה במסך הבית בזמן פיתוח (1 = פעיל).
# עובד גם בלי חיבור לשרת, לעבודה על העיצוב.
EXPO_PUBLIC_SEED_DEMO=

# מפתח ה־API של המודל לא נכנס לכאן. אף פעם.
# הוא יושב ב־Secrets של פרויקט ה־Supabase:
#   npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# וה־Edge Function היחידה שקוראת אותו.
