# העתק ל-.env.local. כל מה שמתחיל ב-NEXT_PUBLIC_ נארז לתוך ה-bundle
# ונגיש לכל מי שפותח את האתר — לכן רק ערכים ציבוריים שם.

# ── Supabase (ציבורי) ───────────────────────────────────────────────
# Project Settings → API. מפתח ה-publishable ציבורי בכוונה: RLS חוסמת
# מולו כל מה שלא שייך למשתמש המחובר.
NEXT_PUBLIC_SUPABASE_URL=https://ecokutjdqppemewxyvat.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Supabase (סודי — שרת בלבד) ──────────────────────────────────────
# עוקף RLS. אסור לו להופיע בשום משתנה NEXT_PUBLIC_, ואסור לו להיקרא
# מקוד שרץ בדפדפן.
SUPABASE_SERVICE_ROLE_KEY=

# ── כתובת האתר ──────────────────────────────────────────────────────
# משמשת לבניית כתובות החזרה של OAuth. בוורסל זה הדומיין האמיתי,
# ומעולם לא localhost בייצור.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── כפתור "דלג" במסכי ההרשמה והכניסה ─────────────────────────────────
# דלוק כברירת מחדל. מכניס לחשבון הדגמה **משותף** בלחיצה אחת, כדי
# שאפשר יהיה לראות את המוצר בלי לפתוח חשבון.
# לכבות לפני שתלמידים אמיתיים נכנסים:
NEXT_PUBLIC_DEMO_LOGIN=

# ── המודל ───────────────────────────────────────────────────────────
# מפתח ה-API של המודל לא נכנס לכאן. אף פעם.
# הוא יושב ב-Secrets של פרויקט ה-Supabase, וה-Edge Function היחידה
# שקוראת אותו:
#   npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   npx supabase secrets set LAMDAI_MODEL=claude-opus-5

# ── סליקה (סודי — שרת בלבד) ─────────────────────────────────────────
# PayPlus. בלי שלושת המשתנים האלה כפתור התשלום פשוט לא מוצג — כדי
# שלא יהיה במסך כפתור שנראה כמו תשלום ולא גובה.
# ברירת המחדל של הכתובת היא סביבת הבדיקות של PayPlus. מעבר לייצור:
#   PAYPLUS_BASE_URL=https://restapi.payplus.co.il
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_PAYMENT_PAGE_UID=
PAYPLUS_BASE_URL=

# ── יצירת קשר לרכישה ────────────────────────────────────────────────
# כל עוד הסליקה לא פתוחה, זה מסלול הרכישה: התלמיד כותב, מעביר תשלום,
# ומקבל קוד הפעלה. כל ערוץ מתאים — וואטסאפ, מייל, אינסטגרם.
# בלי הערך הזה פשוט לא מוצג כפתור יצירת קשר.
#   NEXT_PUBLIC_CONTACT_URL=https://wa.me/972500000000
NEXT_PUBLIC_CONTACT_URL=
