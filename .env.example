# העתק ל־.env מקומי. כל מה שמתחיל ב־EXPO_PUBLIC_ נארז לתוך החבילה
# ונגיש לכל מי שמחזיק את האפליקציה — לכן רק ערכים ציבוריים כאן.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# חומרי הדגמה במסך הבית בזמן פיתוח (1 = פעיל)
EXPO_PUBLIC_SEED_DEMO=

# מפתח ה־API של המודל לא נכנס לכאן. אף פעם.
# הוא יושב ב־Secrets של פרויקט ה־Supabase, וה־Edge Function היחידה שקוראת אותו.
